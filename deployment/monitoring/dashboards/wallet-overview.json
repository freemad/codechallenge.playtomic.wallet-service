{
  "uid": "wallet-overview",
  "title": "Wallet overview",
  "schemaVersion": 39,
  "tags": ["wallet"],
  "refresh": "15s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Wallet scrape health (1 = up)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "local-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"wallet\"}", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 2, "title": "Wallet API traffic by route and HTTP status", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (method, uri, status) (rate(http_server_requests_seconds_count{job=\"wallet\",uri=~\"/api/v1/wallets.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}} {{status}}"}]
    },
    {
      "id": 3, "title": "Mean wallet API latency by route", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (method, uri) (rate(http_server_requests_seconds_sum{job=\"wallet\",uri=~\"/api/v1/wallets.*\"}[$__rate_interval])) / sum by (method, uri) (rate(http_server_requests_seconds_count{job=\"wallet\",uri=~\"/api/v1/wallets.*\"}[$__rate_interval]))", "legendFormat": "{{method}} {{uri}}"}]
    },
    {
      "id": 4, "title": "Mutation results emitted per second", "type": "timeseries",
      "description": "Includes replayed results; not a count of unique payments. No series until a mutation emits a result.",
      "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "local-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (operation, status) (rate(wallet_operation_results_total{job=\"wallet\"}[$__rate_interval]))", "legendFormat": "{{operation}} {{status}}"}]
    }
  ]
}

